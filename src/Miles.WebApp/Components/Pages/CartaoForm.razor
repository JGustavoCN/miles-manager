@using Miles.Application.DTOs
@using Miles.Application.Interfaces
@using Miles.Core.Exceptions
@using MudBlazor

@inject ICartaoService CartaoService
@inject IProgramaService ProgramaService

<MudDialog>
    <DialogContent>
        @* UC-08 FE-01: Exibição estruturada de erros de validação da entidade *@
        <ValidationErrors Errors="@_errosValidacao" />

        <MudForm @ref="form" @bind-IsValid="@success">
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect T="int" Label="Programa de Fidelidade" @bind-Value="cartaoModel.ProgramaId"
                        Required="true" RequiredError="Selecione um programa">
                        @if (programas != null)
                        {
                            @foreach (var prog in programas)
                            {
                                <MudSelectItem Value="@prog.Id">@prog.Nome (@prog.Banco)</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" Label="Nome do Cartão" @bind-Value="cartaoModel.Nome" Required="true"
                        RequiredError="Nome é obrigatório!" HelperText="Ex: Visa Infinite XP" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect T="string" Label="Bandeira" @bind-Value="cartaoModel.Bandeira" Required="true"
                        RequiredError="Selecione a bandeira">
                        <MudSelectItem Value="@("Visa")">Visa</MudSelectItem>
                        <MudSelectItem Value="@("Mastercard")">Mastercard</MudSelectItem>
                        <MudSelectItem Value="@("Elo")">Elo</MudSelectItem>
                        <MudSelectItem Value="@("Amex")">American Express</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="cartaoModel.Limite" Label="Limite (R$)" Format="N2" Min="0"
                        Required="true" RequiredError="Limite é obrigatório" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="cartaoModel.DiaVencimento" Label="Dia do Vencimento" Min="1" Max="31"
                        Required="true" RequiredError="Dia do vencimento é obrigatório" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="cartaoModel.FatorConversao" Label="Pontos por Dólar" Format="N1"
                        Min="0.1M" Step="0.1M" Required="true" RequiredError="Fator de conversão é obrigatório"
                        HelperText="Ex: 2.0 (2 pontos/US$)" />
                </MudItem>

            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!success || loading)" OnClick="Salvar">
            @if (loading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">Salvando</MudText>
            }
            else
            {
                <MudText>Salvar</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int UsuarioId { get; set; }

    [Parameter]
    public CartaoInputDTO? CartaoParaEditar { get; set; }

    private CartaoInputDTO cartaoModel = new();
    private List<ProgramaInputDTO>? programas = new(); // DTO do programa para o Select
    private MudForm form = null!;
    private bool success;
    private bool loading;
    private bool isEdicao => CartaoParaEditar != null;

    private List<string>? _errosValidacao;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProgramas();

        if (isEdicao && CartaoParaEditar != null)
        {
            // Preenche o formulário se for edição
            cartaoModel = new CartaoInputDTO
            {
                Id = CartaoParaEditar.Id,
                Nome = CartaoParaEditar.Nome,
                Bandeira = CartaoParaEditar.Bandeira,
                Limite = CartaoParaEditar.Limite,
                DiaVencimento = CartaoParaEditar.DiaVencimento,
                FatorConversao = CartaoParaEditar.FatorConversao,
                UsuarioId = UsuarioId, // Garante que mantém o usuário da sessão
                ProgramaId = CartaoParaEditar.ProgramaId
            };
        }
        else
        {
            // Novo
            cartaoModel.UsuarioId = UsuarioId;
        }
    }

    private async Task CarregarProgramas()
    {
        try
        {
            programas = await ProgramaService.ObterPorUsuarioAsync(UsuarioId);
        }
        catch (Exception)
        {
            // O tratamento principal de erro pode ser no log, 
            // modal deve ficar mais limpo se falhar (lista vazia).
            programas = new List<ProgramaInputDTO>();
        }
    }

    void Cancelar() => MudDialog.Cancel();

    private async Task Salvar()
    {
        await form.Validate();
        if (!form.IsValid) return;

        loading = true;
        _errosValidacao = null;

        try
        {
            if (isEdicao)
            {
                await CartaoService.AtualizarAsync(cartaoModel);
            }
            else
            {
                await CartaoService.CadastrarAsync(cartaoModel);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Miles.Core.Exceptions.ValidationException ex)
        {
            // UC-08 FE-01: Exibe lista detalhada de erros via <ValidationErrors>
            _errosValidacao = ex.Errors.ToList();
        }
        catch (ValorInvalidoException ex)
        {
            _errosValidacao = new List<string> { ex.Message };
        }
        finally
        {
            loading = false;
        }
    }
}
