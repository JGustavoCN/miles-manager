@page "/nova-transacao"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Miles.Application.DTOs
@using Miles.Application.Interfaces
@using Miles.Core.Exceptions

@inject ITransacaoService TransacaoService
@inject ICartaoService CartaoService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Nova Transação - Miles Manager</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">
    <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Class="mr-2" />
    Nova Transação
</MudText>

<MudText Typo="Typo.body1" Class="mb-4">
    Registre uma nova despesa para simular a geração de pontos.
</MudText>

<MudCard Elevation="3">
    <MudCardContent>
        @if (cartoes == null)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mx-auto d-block" />
        }
        else if (!cartoes.Any())
        {
            <MudAlert Severity="Severity.Warning">
                Você precisa cadastrar um cartão de crédito primeiro.
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/cartoes">Ir para Cartões</MudButton>
            </MudAlert>
        }
        else
        {
            @* UC-08 FE-01: Exibição estruturada de erros de validação *@
            <ValidationErrors Errors="@_errosValidacao" />

            <MudForm @ref="form" @bind-IsValid="@success">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Descrição" @bind-Value="transacaoModel.Descricao" Required="true"
                            RequiredError="Descrição é obrigatória" MaxLength="100" Counter="100"
                            HelperText="Ex: Compra Carrefour" Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudNumericField @bind-Value="transacaoModel.Valor" Label="Valor (R$)" Format="N2" Min="0.01M"
                            Required="true" RequiredError="Valor é obrigatório. Deve ser maior que 0." Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudSelect T="string" Label="Categoria" @bind-Value="transacaoModel.Categoria" Required="true"
                            RequiredError="Categoria é obrigatória">
                            <MudSelectItem Value="@("Alimentação")">Alimentação</MudSelectItem>
                            <MudSelectItem Value="@("Transporte")">Transporte</MudSelectItem>
                            <MudSelectItem Value="@("Educação")">Educação</MudSelectItem>
                            <MudSelectItem Value="@("Entretenimento")">Entretenimento</MudSelectItem>
                            <MudSelectItem Value="@("Viagem")">Viagem</MudSelectItem>
                            <MudSelectItem Value="@("Saúde")">Saúde</MudSelectItem>
                            <MudSelectItem Value="@("Outros")">Outros</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudDatePicker Label="Data da Transação" @bind-Date="dataSelecionada" Required="true"
                            RequiredError="Data é obrigatória" DisableToolbar="true" DateFormat="dd/MM/yyyy" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudNumericField @bind-Value="transacaoModel.CotacaoDolar" Label="Cotação do Dólar (R$)" Format="N2"
                            Min="1.00M" Required="true" RequiredError="Cotação é obrigatória."
                            HelperText="Valor usado para conversão" Immediate="true" />
                    </MudItem>

                    <MudItem xs="12" md="12">
                        <MudSelect T="int" Label="Cartão de Crédito" @bind-Value="transacaoModel.CartaoId" Required="true"
                            RequiredError="Selecione um cartão de crédito">
                            @foreach (var cartao in cartoes)
                            {
                                <MudSelectItem Value="@cartao.Id">@cartao.Nome (@cartao.Bandeira)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                </MudGrid>
            </MudForm>
        }
    </MudCardContent>
    <MudCardActions Class="pb-4 pl-4 pr-4">
        <MudButton Variant="Variant.Text" OnClick="Voltar">Cancelar</MudButton>
        <MudSpacer />
        @if (cartoes != null && cartoes.Any())
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!success || loading)" OnClick="Salvar">
                @if (loading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Salvando</MudText>
                }
                else
                {
                    <MudText>Salvar Transação</MudText>
                }
            </MudButton>
        }
    </MudCardActions>
</MudCard>

@code {
    private TransacaoDTO transacaoModel = new()
    {
        CotacaoDolar = 5.0m // Valor default
    };

    private DateTime? dataSelecionada = DateTime.Now;
    private List<CartaoDTO>? cartoes;
    private int currentUserId;

    private MudForm form = null!;
    private bool success;
    private bool loading;

    private List<string>? _errosValidacao;

    protected override async Task OnInitializedAsync()
    {
        await CarregarUsuario();
        await CarregarCartoes(); // Sync transformado em Async
    }

    private async Task CarregarUsuario()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var idClaim = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out int id))
        {
            currentUserId = id;
        }
    }

    private async Task CarregarCartoes()
    {
        try
        {
            if (currentUserId > 0)
            {
                cartoes = await CartaoService.ObterPorUsuarioAsync(currentUserId);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar cartões: {ex.Message}", Severity.Error);
        }
    }

    private void Voltar()
    {
        NavigationManager.NavigateTo("/compras");
    }

    private async Task Salvar()
    {
        await form.Validate();
        if (!form.IsValid || cartoes == null || !cartoes.Any()) return;

        // Limpa erros de submissão anterior
        _errosValidacao = null;
        loading = true;

        try
        {
            transacaoModel.Data = dataSelecionada ?? DateTime.Now;

            // Envia para Application Layer via Async
            await TransacaoService.AdicionarAsync(transacaoModel);

            Snackbar.Add("Transação salva com sucesso e pontos simulados!", Severity.Success);

            NavigationManager.NavigateTo("/compras");
        }
        catch (Miles.Core.Exceptions.ValidationException ex)
        {
            // UC-08 FE-01: Exibe lista detalhada de erros via <ValidationErrors>
            _errosValidacao = ex.Errors.ToList();
        }
        catch (ValorInvalidoException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao salvar: {ex.Message}", Severity.Error);
        }
        finally
        {
            loading = false;
        }
    }
}
