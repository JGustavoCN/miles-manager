@page "/programas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Miles.Application.DTOs
@using Miles.Application.Interfaces
@using Miles.Core.Exceptions

@inject IProgramaService ProgramaService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Programas de Fidelidade - Miles Manager</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">
    <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Class="mr-2" />
    Programas de Fidelidade
</MudText>

<MudText Typo="Typo.body1" Class="mb-4">
    Gerencie seus programas de fidelidade, como companhias aéreas ou recompensas de cartão de crédito.
</MudText>

<MudToolBar Class="mb-4 px-0">
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
        OnClick="AbrirModalCadastro">
        Novo Programa
    </MudButton>
</MudToolBar>

@if (programas == null)
{
    // Mudança: Mostrar progress bar enquanto carrega (Async)
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mx-auto d-block mt-4" />
}
else if (!programas.Any())
{
    // Mudança: Empty State mais bonito caso não tenha programas
    <MudAlert Severity="Severity.Info" Class="mt-4">
        Você ainda não possui nenhum programa de fidelidade cadastrado. Clique no botão acima para adicionar um.
    </MudAlert>
}
else
{
    <MudGrid>
        @foreach (var programa in programas)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@programa.Nome</MudText>
                            @if (!string.IsNullOrWhiteSpace(programa.Banco))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Banco: @programa.Banco</MudText>
                            }
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.FlightTakeoff" Color="Color.Primary" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2">
                            Total de Pontos (Simulado): --
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        @* Mudança: Passar o objeto DTO completo *@
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                            OnClick="() => AbrirModalEdicao(programa)">Editar</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                            OnClick="() => ConfirmarExclusao(programa)">Excluir</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@* --- DIALOG (MODAL) DE CADASTRO/EDIÇÃO --- *@
<MudDialog @bind-Visible="dialogVisible" Options="dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(isEdicao? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" />
            @(isEdicao ? "Editar Programa" : "Novo Programa")
        </MudText>
    </TitleContent>
    <DialogContent>
        @* UC-08 FE-01: Componente de validação que exibe as mensagens de erro em tela de forma padronizada *@
        <ValidationErrors Errors="@_errosValidacao" />

        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField T="string" Label="Nome do Programa" @bind-Value="programaModel.Nome" Required="true"
                RequiredError="Nome é obrigatório!" Counter="100" MaxLength="100" HelperText="Ex: Smiles, Livelo" />
            <MudTextField T="string" Label="Empresa ou Banco" @bind-Value="programaModel.Banco" Counter="100"
                MaxLength="100" HelperText="Ex: Gol, Bradesco" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="FecharModal">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SalvarPrograma" Disabled="@(!success)">Salvar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // Mudança: Agora listamos DTOs, não Entidades (Application Layer -> View)
    private List<ProgramaInputDTO>? programas;

    private ProgramaInputDTO programaModel = new();
    private bool dialogVisible;
    private bool isEdicao;

    private MudForm form = null!;

    private bool success;
    private int currentUserId;
    private DialogOptions dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    private List<string>? _errosValidacao;

    protected override async Task OnInitializedAsync()
    {
        await CarregarUsuario();
        await CarregarProgramas(); // Agora é Async
    }

    private async Task CarregarUsuario()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var idClaim = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out int id))
        {
            currentUserId = id;
        }
    }

    // Mudança: Método Async para não bloquear a UI
    private async Task CarregarProgramas()
    {
        try
        {
            if (currentUserId > 0)
            {
                // Chama o novo método Async do serviço
                programas = await ProgramaService.ObterPorUsuarioAsync(currentUserId);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar programas: {ex.Message}", Severity.Error);
        }
    }

    // --- Ações de Modal ---

    private void AbrirModalCadastro()
    {
        isEdicao = false;
        programaModel = new ProgramaInputDTO { UsuarioId = currentUserId };
        _errosValidacao = null; // limpa erros anteriores
        dialogVisible = true;
    }

    // Mudança: Recebe DTO
    private void AbrirModalEdicao(ProgramaInputDTO programa)
    {
        isEdicao = true;
        // Clonamos o objeto para evitar edição direta na referência da lista antes de salvar
        programaModel = new ProgramaInputDTO
        {
            Id = programa.Id,
            Nome = programa.Nome,
            Banco = programa.Banco,
            UsuarioId = programa.UsuarioId
        };
        _errosValidacao = null; // limpa erros anteriores
        dialogVisible = true;
    }

    private void FecharModal() => dialogVisible = false;

    private async Task SalvarPrograma()
    {
        await form.Validate();
        if (!form.IsValid) return;

        _errosValidacao = null;

        try
        {
            programaModel.UsuarioId = currentUserId;

            if (isEdicao)
            {
                // Mudança: Chamada Async
                await ProgramaService.AtualizarAsync(programaModel);
                Snackbar.Add("Programa atualizado com sucesso!", Severity.Success);
            }
            else
            {
                // Mudança: Chamada Async
                await ProgramaService.AdicionarAsync(programaModel);
                Snackbar.Add("Programa de fidelidade cadastrado com sucesso", Severity.Success);
            }

            dialogVisible = false;
            await CarregarProgramas();
        }
        catch (Miles.Core.Exceptions.ValidationException ex)
        {
            _errosValidacao = ex.Errors.ToList();
        }
        catch (ValorInvalidoException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro inesperado: {ex.Message}", Severity.Error);
        }
    }

    // --- Ação de Exclusão ---

    // Mudança: Recebe DTO
    private async Task ConfirmarExclusao(ProgramaInputDTO programa)
    {
        bool? result = await DialogService.ShowMessageBox(
        "Excluir Programa",
        $"Tem certeza que deseja excluir '{programa.Nome}'? Esta ação não pode ser desfeita.",
        yesText: "Excluir", cancelText: "Cancelar");

        if (result == true)
        {
            try
            {
                // Mudança: Chamada Async
                await ProgramaService.RemoverAsync(programa.Id);

                Snackbar.Add("Programa removido com sucesso!", Severity.Success);
                await CarregarProgramas();
            }
            catch (ValorInvalidoException ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erro ao excluir: {ex.Message}", Severity.Error);
            }
        }
    }
}
