@page "/programas"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Miles.Application.DTOs
@using Miles.Application.Interfaces
@using Miles.Core.Exceptions

@inject IProgramaService ProgramaService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Programas de Fidelidade - Miles Manager</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">
    <MudIcon Icon="@Icons.Material.Filled.CardGiftcard" Class="mr-2" />
    Programas de Fidelidade
</MudText>

<MudText Typo="Typo.body1" Class="mb-4">
    Gerencie seus programas de fidelidade, como companhias aéreas ou recompensas de cartão de crédito.
</MudText>

<MudToolBar Class="mb-4 px-0">
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
        OnClick="AbrirModalCadastro">
        Novo Programa
    </MudButton>
</MudToolBar>

@if (programas == null)
{
    // Mudança: Mostrar progress bar enquanto carrega (Async)
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mx-auto d-block mt-4" />
}
else if (!programas.Any())
{
    // Mudança: Empty State mais bonito caso não tenha programas
    <MudAlert Severity="Severity.Info" Class="mt-4">
        Você ainda não possui nenhum programa de fidelidade cadastrado. Clique no botão acima para adicionar um.
    </MudAlert>
}
else
{
    <MudGrid>
        @foreach (var programa in programas)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="3" Class="h-100">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@programa.Nome</MudText>
                            @if (!string.IsNullOrWhiteSpace(programa.Banco))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">Banco: @programa.Banco</MudText>
                            }
                        </CardHeaderContent>
                        <CardHeaderActions>
                            <MudIconButton Icon="@Icons.Material.Filled.FlightTakeoff" Color="Color.Primary" />
                        </CardHeaderActions>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2">
                            Total de Pontos (Simulado): --
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        @* Mudança: Passar o objeto DTO completo *@
                        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                            OnClick="() => AbrirModalEdicao(programa)">Editar</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                            OnClick="() => ConfirmarExclusao(programa)">Excluir</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}



@code {
    // Mudança: Agora listamos DTOs, não Entidades (Application Layer -> View)
    private List<ProgramaInputDTO>? programas;

    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        await CarregarUsuario();
        await CarregarProgramas(); // Agora é Async
    }

    private async Task CarregarUsuario()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var idClaim = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idClaim, out int id))
        {
            currentUserId = id;
        }
    }

    // Mudança: Método Async para não bloquear a UI
    private async Task CarregarProgramas()
    {
        try
        {
            if (currentUserId > 0)
            {
                // Chama o novo método Async do serviço
                programas = await ProgramaService.ObterPorUsuarioAsync(currentUserId);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao carregar programas: {ex.Message}", Severity.Error);
        }
    }

    // --- Ações de Modal ---

    private async Task AbrirModalCadastro()
    {
        await AbrirModal(null);
    }

    private async Task AbrirModalEdicao(ProgramaInputDTO programa)
    {
        await AbrirModal(programa);
    }

    private async Task AbrirModal(ProgramaInputDTO? programa)
    {
        var parameters = new DialogParameters();
        parameters.Add("UsuarioId", currentUserId);

        string titulo = "Novo Programa";

        if (programa != null)
        {
            titulo = "Editar Programa";
            parameters.Add("ProgramaParaEditar", programa);
        }

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

        var dialog = await DialogService.ShowAsync<ProgramaForm>(titulo, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            Snackbar.Add(programa == null ? "Programa cadastrado com sucesso!" : "Programa atualizado com sucesso!", Severity.Success);
            await CarregarProgramas();
        }
    }

    // --- Ação de Exclusão ---

    // Mudança: Recebe DTO
    private async Task ConfirmarExclusao(ProgramaInputDTO programa)
    {
        bool? result = await DialogService.ShowMessageBox(
        "Excluir Programa",
        $"Tem certeza que deseja excluir '{programa.Nome}'? Esta ação não pode ser desfeita.",
        yesText: "Excluir", cancelText: "Cancelar");

        if (result == true)
        {
            try
            {
                // Mudança: Chamada Async
                await ProgramaService.RemoverAsync(programa.Id);

                Snackbar.Add("Programa removido com sucesso!", Severity.Success);
                await CarregarProgramas();
            }
            catch (ValorInvalidoException ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Erro ao excluir: {ex.Message}", Severity.Error);
            }
        }
    }
}
